# ==============================================================================
# 🚀 YASCHET'S WEBSITE ENV CONFIGURATION TEMPLATE
# ==============================================================================
# 1. Copy this file to .env (development) or .env.production.local (production)
# 2. Replace placeholder values with actual credentials
# ==============================================================================

# ==============================================================================
# 1. APPLICATION CORE
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT="development" # or production

# =============================================================================
# 2. External Services
# =============================================================================
# 2.1. Email Service
# https://resend.com
# Get your API key from https://resend.com
RESEND_API_KEY=""

# 2.2. Shared contact limits (server-only). Missing configuration stops delivery.
# https://upstash.com/docs/redis/sdks/ratelimit-ts/overview
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Generate once with: openssl rand -hex 32
CONTACT_RATE_LIMIT_SALT=""

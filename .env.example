# ==============================================================================
# 🚀 YASCHET'S WEBSITE ENV CONFIGURATION TEMPLATE
# ==============================================================================
# 1. Copy this file to .env.local for local development
# 2. Replace placeholder values with actual credentials
# 3. Configure deployed secrets in Vercel; never copy production Redis access locally
# ==============================================================================

# ==============================================================================
# 1. APPLICATION CORE
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT="development" # or production

# =============================================================================
# 2. External Services
# =============================================================================
# 2.1. Email Service
# https://resend.com
# Get your API key from https://resend.com
RESEND_API_KEY=""

# 2.2. Shared contact limits (server-only). Missing configuration stops delivery.
# https://upstash.com/docs/redis/sdks/ratelimit-ts/overview
# Use a separate non-production database here, never the production credential.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Generate once with: openssl rand -hex 32
CONTACT_RATE_LIMIT_SALT=""

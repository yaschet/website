{
	"name": "website",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.16.1",
	"engines": {
		"node": ">=22.12.0 <27"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"fix": "biome check --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"check:repository": "node scripts/check-repository.mjs",
		"verify": "pnpm check:repository && pnpm lint && pnpm typecheck",
		"audit:dependencies": "pnpm audit --audit-level=low",
		"quality": "pnpm verify && pnpm audit:dependencies && pnpm test:unit && pnpm build && pnpm test:e2e && pnpm build-storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"analyze": "ANALYZE=true pnpm build",
		"test:e2e": "playwright test",
		"prepare": "husky",
		"test:unit": "playwright test --config playwright.unit.config.ts"
	},
